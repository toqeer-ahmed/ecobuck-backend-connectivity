# EcoBuck Backend Environmental Configurations Template
# Copy this file to a new file named '.env' and populate actual values.

# Server Execution Parameters
DEBUG=True
PORT=8000
HOST=127.0.0.1

# Firebase / Google Cloud Credentials
# Path to your Firebase service account key JSON file
FIREBASE_CREDENTIALS_PATH=credentials/firebase_service_account.json
FIRESTORE_DATABASE_ID=(default)

# Mobile Client JWT Authorization Keys
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET_KEY=ecobuck_very_secure_jwt_signing_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate Limiting & Safety Controls
RATE_LIMIT_PER_MINUTE=60
DEVICE_INGESTION_RATE_LIMIT=2
HEARTBEAT_TIMEOUT_SECONDS=900
